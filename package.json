{
  "name": "circular-dependency-companion",
  "displayName": "Circular Dependency Companion",
  "description": "Detect circular dependencies between modules of a multi-module Gradle project -- 100% static text parsing, no Gradle daemon, no data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "gradle",    "circular-dependency",    "modules",    "architecture",    "build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-circular-dependency-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-circular-dependency-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "circularDependencyCompanion.analyze",
        "title": "Circular Dependency Companion: Analyze Gradle Modules"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
